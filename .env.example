# The Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# The exact Discord User ID of the Bot Owner
OWNER_ID=your_owner_id_here

# The Client ID of your Discord Bot
CLIENT_ID=your_client_id_here

# The Client Secret for OAuth2 flows
CLIENT_SECRET=your_client_secret_here

# The redirect URI used in the OAuth flow (Must match the Discord Dev Portal EXACTLY)
OAUTH_REDIRECT_URI=https://your-domain.com/callback

# Webhook URL for sending automated test reports upon startup
TEST_REPORT_WEBHOOK_URL=your_webhook_url_here
